# =====================================================================
#  The ONLY settings file. Easiest way to fill it:  npm run setup
# =====================================================================

PORT=4000
DATABASE_URL=postgres://postgres:password@localhost:5433/lab_loans
CORS_ORIGIN=http://localhost:4000,http://localhost:5173,http://localhost:8080

# Google accounts (comma separated) that become ADMIN when they sign in
ADMIN_EMAILS=admin@test.edu

# --- Firebase: Google sign-in (Auth 2.0) + live events ---
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Firebase console -> Build -> Realtime Database (URL at the top)
FIREBASE_DATABASE_URL=
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# --- Caching plan ---
CACHE_TTL_SECONDS=60

# --- TESTING ONLY ---
# true = the login page also shows an email box (no Google needed). Turn off for the real demo.
AUTH_DEV_BYPASS=true
