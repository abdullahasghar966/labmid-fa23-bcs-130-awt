{
  "name": "lab-loans-api",
  "version": "1.0.0",
  "description": "Lab Equipment Loans API (Variant 0) - Node/Express + PostgreSQL + Firebase",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:local": "node scripts/local-db.js",
    "db:reset": "node scripts/db-reset.js",
