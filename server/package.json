    "firebase:sync": "node scripts/firebase-sync.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^17.11.0-beta.19"
  }
}
